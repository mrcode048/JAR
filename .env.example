# Jarvis AI - Environment Variables (.env dosyası)
# Bu dosyayı kopyalayın ve API anahtar larınızı ekleyin

# OpenAI GPT
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini
GOOGLE_API_KEY=your-google-api-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-claude-key-here

# Tercihi Edilen AI Modu
# Seçenekler: claude, openai, gemini, transformer, local
AI_MODE=claude

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false

# Ses Ayarları
SPEECH_LANGUAGE=tr-TR
SPEECH_RATE=150
SPEECH_VOLUME=0.9
